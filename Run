    <script>
        // Gestione slide
        const slides = document.querySelectorAll('.slide');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const progress = document.getElementById('progress');
        let currentSlide = 0;

        function updateSlides() {
            slides.forEach((slide, index) => {
                slide.classList.toggle('active', index === currentSlide);
            });
            
            const progressPercent = ((currentSlide + 1) / slides.length) * 100;
            progress.style.width = `${progressPercent}%`;

            if(slides[currentSlide].classList.contains('quiz-slide')) {
                progress.classList.add('quiz-mode');
                nextBtn.classList.add('quiz-next');
            } else {
                progress.classList.remove('quiz-mode');
                nextBtn.classList.remove('quiz-next');
            }

            prevBtn.disabled = currentSlide === 0;
            nextBtn.disabled = currentSlide === slides.length - 1;
        }

        nextBtn.addEventListener('click', () => {
            if (currentSlide < slides.length - 1) {
                currentSlide++;
                updateSlides();
            }
        });

        prevBtn.addEventListener('click', () => {
            if (currentSlide > 0) {
                currentSlide--;
                updateSlides();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' && currentSlide < slides.length - 1) nextBtn.click();
            if (e.key === 'ArrowLeft' && currentSlide > 0) prevBtn.click();
        });

        // Dati del Quiz
        const quizQuestions = [
            {
                q: "Qual è la differenza fondamentale nel funzionamento dell'IA generativa rispetto a quella tradizionale?",
                options: [
                    { text: "Analizza i dati storici senza modificarli", correct: false },
                    { text: "Produce sempre nuovi contenuti sulla base di probabilità statistiche", correct: true },
                    { text: "Possiede una coscienza artificiale autonoma", correct: false },
                    { text: "Esegue calcoli più rapidi su archivi digitali esterni", correct: false }
                ]
            },
            {
                q: "Cosa succede se i dati inseriti in una conversazione superano la 'finestra di contesto'?",
                options: [
                    { text: "Il sistema si blocca richiedendo un riavvio hardware", correct: false },
                    { text: "L'algoritmo comincia a dimenticare le prime informazioni inserite", correct: true },
                    { text: "La risposta viene elaborata in modalità protetta", correct: false },
                    { text: "I token vengono raddoppiati automaticamente", correct: false }
                ]
            },
            {
                q: "Che cos'è un'allucinazione nel contesto dei modelli linguistici?",
                options: [
                    { text: "Un errore causato da infiltrazioni di virus informatici", correct: false },
                    { text: "Una risposta falsa generata con grande sicurezza formale", correct: true },
                    { text: "Un rallentamento temporaneo dei server di elaborazione", correct: false },
                    { text: "Il riflesso dei pregiudizi umani presenti nel database", correct: false }
                ]
            },
            {
                q: "Quale rischio comporta l'accettazione passiva dell'output senza revisione umana?",
                options: [
                    { text: "La perdita di connettività di rete", correct: false },
                    { text: "La resa cognitiva e l'atrofia del pensiero critico", correct: true },
                    { text: "Il blocco immediato delle licenze d'uso", correct: false },
                    { text: "La corruzione dei file di testo archiviati sul PC", correct: false }
                ]
            },
            {
                q: "Come si contrasta efficacemente il fenomeno della sycophancy (compiacenza artificiale)?",
                options: [
                    { text: "Scrivendo prompt corti e privi di punteggiatura", correct: false },
                    { text: "Progettando un attrito cognitivo intenzionale nel prompt", correct: true },
                    { text: "Sostituendo il modello linguistico con un'AI tradizionale", correct: false },
                    { text: "Confermando all'IA che la sua idea è corretta", correct: false }
                ]
            }
        ];

        let currentQuestionIndex = 0;
        let totalScore = 0;

        function runQuiz() {
            const playground = document.getElementById('quiz-playground');
            const resultsDiv = document.getElementById('quiz-results');
            
            if (currentQuestionIndex < quizQuestions.length) {
                playground.style.display = 'block';
                resultsDiv.style.display = 'none';
                
                const currentQ = quizQuestions[currentQuestionIndex];
                document.getElementById('q-text').innerText = `${currentQuestionIndex + 1}. ${currentQ.q}`;
                
                const optionsContainer = document.getElementById('q-options');
                optionsContainer.innerHTML = '';
                
                currentQ.options.forEach(opt => {
                    const btn = document.createElement('button');
                    btn.classList.add('quiz-opt-btn');
                    btn.innerText = opt.text;
                    btn.addEventListener('click', () => handleAnswer(opt.correct));
                    optionsContainer.appendChild(btn);
                });
            } else {
                playground.style.display = 'none';
                resultsDiv.style.display = 'block';
                
                const scoreDisplay = document.getElementById('final-score');
                const commentDisplay = document.getElementById('score-comment');
                
                scoreDisplay.innerText = `${totalScore}/10`;
                scoreDisplay.classList.remove('special-celebration');
                
                if (totalScore < 6) {
                    commentDisplay.innerText = "Non scoraggiarti: l'IA generativa richiede un cambio di paradigma. Rileggi le slide sull'attrito cognitivo e riprova il test per dominare la macchina!";
                } else if (totalScore < 8) {
                    commentDisplay.innerText = "Buon risultato: hai appreso i concetti fondamentali e sai distinguere i limiti strutturali del mezzo. Sei pronto per applicare la supervisione umana!";
                } else {
                    scoreDisplay.classList.add('special-celebration');
                    commentDisplay.innerHTML = "<span class='special-celebration'>LIVELLO ARTIGIANO DELL'IA: SBLOCCATO! 🕹️</span><br>Hai distrutto la compiacenza statistica. Il pensiero critico è salvo, Turing approverebbe la tua strategia.";
                }
            }
        }

        function handleAnswer(isCorrect) {
            if (isCorrect) totalScore += 2;
            currentQuestionIndex++;
            runQuiz();
        }

        function restartQuiz() {
            currentQuestionIndex = 0;
            totalScore = 0;
            runQuiz();
        }

        updateSlides();
        runQuiz();
    </script>
</body>
</html>
